# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MIDTRANS_SERVER_KEY: Required for Midtrans payment gateway integration.
MIDTRANS_SERVER_KEY="YOUR_MIDTRANS_SERVER_KEY"
MIDTRANS_CLIENT_KEY="YOUR_MIDTRANS_CLIENT_KEY"

# GENIEACS_API_URL: URL to GeniaACS API
GENIEACS_API_URL="http://your-genieacs-server:7557"
GENIEACS_API_TOKEN="YOUR_GENIEACS_API_TOKEN"

# JWT_SECRET: Secret key for JWT token signing
JWT_SECRET="YOUR_JWT_SECRET"

# FONNTE_TOKEN: Required for Whatsapp Gateway (via Fonnte API)
FONNTE_TOKEN="YOUR_FONNTE_TOKEN"
